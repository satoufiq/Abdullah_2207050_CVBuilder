<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="CVBuilder.Controllers.PreviewController">

    <top>
        <HBox spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Label blendMode="SRC_ATOP" cache="true" style="-fx-font-size:20px; -fx-font-weight:700;" text="Curriculum Vitae" textFill="#2812e0" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#goBack" text="Edit " textFill="#4703e7" />
        </HBox>
    </top>

    <center>
        <HBox spacing="20">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <VBox prefWidth="220" spacing="8">
                <ImageView fx:id="profileImageView" fitWidth="160" preserveRatio="true" />
                <Label fx:id="nameLabel" />
                <Label fx:id="emailLabel" />
                <Label fx:id="phoneLabel" />
                <Label fx:id="addressLabel" wrapText="true" />
            </VBox>

            <VBox spacing="12">

                <VBox>
                    <Label text="Education">
                  <font>
                     <Font name="Agency FB Bold" size="16.0" />
                  </font></Label>
                    <VBox fx:id="educationBox" />
                </VBox>

                <VBox>
                    <Label prefHeight="25.0" prefWidth="58.0" text="Experience" textFill="#1d1d1e">
                  <font>
                     <Font name="Agency FB Bold" size="15.0" />
                  </font></Label>
                    <VBox fx:id="experienceBox" />
                </VBox>

                <VBox>
                    <Label text="Projects">
                  <font>
                     <Font name="Agency FB Bold" size="15.0" />
                  </font></Label>
                    <VBox fx:id="projectsBox" />
                </VBox>

                <VBox>
                    <Label text="Skills">
                  <font>
                     <Font name="Agency FB Bold" size="15.0" />
                  </font></Label>
                    <VBox fx:id="skillsBox" />
                </VBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>
