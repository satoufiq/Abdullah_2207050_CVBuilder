<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="CVBuilder.Controllers.CVFormController"
            style="-fx-background-color: linear-gradient(to bottom right, #f4f5fa, #4468c5);">


    <top>
        <HBox spacing="10"
              style="-fx-background-color:#10103c;
                     -fx-padding:12 16;
                     -fx-border-color:#10103c;
                     -fx-border-width:0 0 1 0;">

            <Label text="Create Your CV"
                   style="-fx-font-size:22px;
                          -fx-font-weight:900;
                          -fx-text-fill:#ffffff;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Back"
                    onAction="#goBack"
                    style="-fx-font-size:14px;
                           -fx-background-color:#ecefff;
                           -fx-padding:6 14;
                           -fx-background-radius:6;
                           -fx-font-weight:bold;
                           -fx-text-fill:#222;"/>
        </HBox>
    </top>



    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    style="-fx-background-color:transparent;">

            <VBox spacing="22"
                  style="-fx-padding:30;">


                <Label text="Personal Information"
                       style="-fx-font-size:18px;
                              -fx-font-weight:900;
                              -fx-text-fill:#2a2a44;"/>

                <TextField fx:id="fullNameField" promptText="Full Name"
                           style="-fx-background-radius:8;
                                  -fx-padding:10;"/>

                <TextField fx:id="emailField" promptText="Email"
                           style="-fx-background-radius:8;
                                  -fx-padding:10;"/>

                <TextField fx:id="phoneField" promptText="Phone"
                           style="-fx-background-radius:8;
                                  -fx-padding:10;"/>

                <TextArea fx:id="addressArea" promptText="Address"
                          prefRowCount="2"
                          style="-fx-background-radius:8;
                                 -fx-padding:10;"/>


                <VBox spacing="10">
                    <Label text="Profile Photo"
                           style="-fx-font-size:16px;
                                  -fx-font-weight:900;
                                  -fx-text-fill:#2a2a44;"/>

                    <ImageView fx:id="profileImageView"
                               fitWidth="120"
                               preserveRatio="true"
                               style="-fx-effect: innershadow(gaussian, #b0b0d0, 12, 0.2, 0, 0);"/>

                    <Button fx:id="uploadImageBtn"
                            text="Upload Profile Photo"
                            onAction="#uploadImage"
                            style="-fx-background-color:#4052ff;
                                   -fx-text-fill:white;
                                   -fx-padding:8 18;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:8;"/>
                </VBox>



                <VBox spacing="10">
                    <Label text="Education"
                           style="-fx-font-size:16px;
                                  -fx-font-weight:900;
                                  -fx-text-fill:#2a2a44;"/>

                    <VBox fx:id="educationContainer" spacing="6"/>

                    <Button text="+ Add Education"
                            onAction="#addEducation"
                            style="-fx-background-color:#dfe3ff;
                                   -fx-text-fill:#182052;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:6;"/>
                </VBox>



                <VBox spacing="10">
                    <Label text="Skills"
                           style="-fx-font-size:16px;
                                  -fx-font-weight:900;
                                  -fx-text-fill:#2a2a44;"/>

                    <VBox fx:id="skillsContainer" spacing="6"/>

                    <Button text="+ Add Skill"
                            onAction="#addSkill"
                            style="-fx-background-color:#dfe3ff;
                                   -fx-text-fill:#182052;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:6;"/>
                </VBox>



                <VBox spacing="10">
                    <Label text="Work Experience"
                           style="-fx-font-size:16px;
                                  -fx-font-weight:900;
                                  -fx-text-fill:#2a2a44;"/>

                    <VBox fx:id="experienceContainer" spacing="6"/>

                    <Button text="+ Add Experience"
                            onAction="#addExperience"
                            style="-fx-background-color:#dfe3ff;
                                   -fx-text-fill:#182052;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:6;"/>
                </VBox>



                <VBox spacing="10">
                    <Label text="Projects"
                           style="-fx-font-size:16px;
                                  -fx-font-weight:900;
                                  -fx-text-fill:#2a2a44;"/>

                    <VBox fx:id="projectsContainer" spacing="6"/>

                    <Button text="+ Add Project"
                            onAction="#addProject"
                            style="-fx-background-color:#dfe3ff;
                                   -fx-text-fill:#182052;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:6;"/>
                </VBox>



                <Button text="Generate CV"
                        onAction="#generateCV"
                        style="-fx-font-size:18px;
                               -fx-background-color:#4a57ff;
                               -fx-text-fill:white;
                               -fx-padding:12 24;
                               -fx-background-radius:10;
                               -fx-font-weight:900;
                               -fx-cursor:hand;"/>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
