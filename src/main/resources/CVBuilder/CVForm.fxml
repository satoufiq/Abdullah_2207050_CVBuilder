<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="CVBuilder.Controllers.CVFormController">

    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Create CV" style="-fx-font-size:20px; -fx-font-weight:700;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back" onAction="#goBack"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="16">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <TextField fx:id="fullNameField" promptText="Full Name"/>
                <TextField fx:id="emailField" promptText="Email"/>
                <TextField fx:id="phoneField" promptText="Phone"/>
                <TextArea fx:id="addressArea" promptText="Address" prefRowCount="2"/>

                <!-- Profile image -->
                <VBox spacing="6">
                    <ImageView fx:id="profileImageView"/>

                    <!-- MUST HAVE fx:id TO AVOID NULLPOINTER -->
                    <Button fx:id="uploadImageBtn"
                            text="Upload Profile Photo"
                            onAction="#uploadImage"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Education"/>
                    <VBox fx:id="educationContainer"/>
                    <Button text="+ Add Education" onAction="#addEducation"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Skills"/>
                    <VBox fx:id="skillsContainer"/>
                    <Button text="+ Add Skill" onAction="#addSkill"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Work Experience"/>
                    <VBox fx:id="experienceContainer"/>
                    <Button text="+ Add Experience" onAction="#addExperience"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Projects"/>
                    <VBox fx:id="projectsContainer"/>
                    <Button text="+ Add Project" onAction="#addProject"/>
                </VBox>

                <Button text="Generate CV"
                        onAction="#generateCV"
                        styleClass="primary-button"/>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
