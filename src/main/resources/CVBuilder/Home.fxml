<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="CVBuilder.Controllers.HomeController"
            style="-fx-background-color: linear-gradient(to bottom right, #4468c5, #10103c);">

    <center>
        <VBox alignment="CENTER" spacing="35">

            <Label text="The CV Builder"
                   style="-fx-font-size:42px;
                          -fx-font-weight:900;
                          -fx-text-fill:#eef1ff;" />

            <Label text="Create, Save and Manage Your CVs Easily"
                   style="-fx-font-size:18px;
                          -fx-text-fill:#eef1ff;" />

            <VBox spacing="25" alignment="CENTER"
                  maxWidth="380"
                  style="-fx-background-color: white;
                         -fx-padding:30 45;
                         -fx-background-radius:14;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 16, 0, 0, 3);">

                <Label text="Get Started"
                       style="-fx-font-size:22px;
                              -fx-font-weight:700;
                              -fx-text-fill:#1a1a33;" />

                <Button text="Create New CV"
                        onAction="#onCreateNewCV"
                        prefWidth="250"
                        style="-fx-font-size:18px;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;
                               -fx-padding:12 20;
                               -fx-background-color:#4a57ff;
                               -fx-text-fill:white;
                               -fx-cursor:hand;" />

                <Button text="View Saved CVs"
                        onAction="#onViewSavedCVs"
                        prefWidth="250"
                        style="-fx-font-size:18px;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;
                               -fx-padding:12 20;
                               -fx-background-color:#ffffff;
                               -fx-text-fill:#4a57ff;
                               -fx-border-color:#4a57ff;
                               -fx-border-width:2;
                               -fx-cursor:hand;" />
            </VBox>

        </VBox>
    </center>

</BorderPane>
