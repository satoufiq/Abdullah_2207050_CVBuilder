<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="CVBuilder.Controllers.HomeController"
            style="-fx-background-color: linear-gradient(to bottom right, #3f5bbb, #0b0b2f);">

    <center>
        <VBox alignment="CENTER" spacing="38">

            <Label text="The CV Builder"
                   style="-fx-font-size:42px;
                          -fx-font-weight:900;
                          -fx-text-fill:#f4f6ff;" />

            <Label text="Create a clean and modern CV"
                   style="-fx-font-size:18px;
                          -fx-font-weight:500;
                          -fx-text-fill:#cdd3ff;" />

            <VBox spacing="28" alignment="CENTER"
                  style="-fx-background-color:white;
                         -fx-padding:32 48;
                         -fx-background-radius:16;
                         -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.18), 16, 0, 0, 3);">

                <Label text="Start building your CV"
                       style="-fx-font-size:22px;
                              -fx-font-weight:800;
                              -fx-text-fill:#1a1a33;" />

                <Button text="Create New CV"
                        onAction="#onCreateNewCV"
                        style="-fx-font-size:18px;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;
                               -fx-padding:12 42;
                               -fx-background-color:#4a57ff;
                               -fx-text-fill:white;
                               -fx-cursor:hand;" />
            </VBox>

        </VBox>
    </center>

</BorderPane>
