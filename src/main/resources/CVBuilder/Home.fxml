<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="CVBuilder.Controllers.HomeController">

    <center>
        <VBox alignment="CENTER" spacing="20">
            <Label text="Welcome to CV Builder"
                   style="-fx-font-size:28px; -fx-font-weight:bold;" />

            <Button text="Create New CV"
                    onAction="#onCreateNewCV"
                    style="-fx-font-size:16px; -fx-padding:8 20;" />
        </VBox>
    </center>

</BorderPane>
