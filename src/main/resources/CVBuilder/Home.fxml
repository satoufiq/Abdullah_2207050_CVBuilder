<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="CVBuilder.Controllers.HomeController"
            style="-fx-background-color: linear-gradient(to bottom right, #f7f8ff, #6d82ff);">

    <center>
        <VBox alignment="CENTER" spacing="28">

            <Label text="CV Builder"
                   style="-fx-font-size:36px;
                          -fx-font-weight:900;
                          -fx-text-fill:#0f0f3a;" />

            <Label text="Create a clean, modern and professional CV"
                   style="-fx-font-size:16px;
                          -fx-text-fill:#1a1a33;" />

            <Button text="Create New CV"
                    onAction="#onCreateNewCV"
                    style="
                        -fx-font-size:18px;
                        -fx-font-weight:bold;
                        -fx-background-radius:10;
                        -fx-padding:12 36;
                        -fx-background-color:#4a57ff;
                        -fx-text-fill:white;
                        -fx-cursor:hand;
                    "/>

        </VBox>
    </center>

</BorderPane>
